# ─────────────────────────────────────────────────────────────
# Devzard Motion — environment
# EVERYTHING IS OPTIONAL. Copy to .env.local and fill what you have.
# The app boots in "sandbox mode" with nothing set, and each
# integration lights up the moment you add its keys / connect OAuth
# from Settings → Integrations.
# ─────────────────────────────────────────────────────────────

# 1) App
# Secret used to encrypt stored tokens + sign dashboard sessions.
# Generate: openssl rand -hex 32
APP_SECRET=dev-secret-change-me-0123456789abcdef0123456789abcdef
# Public URL of this deployment (used for OAuth redirects + webhooks).
APP_URL=http://localhost:3000
# Dashboard login. Defaults: admin / admin (change before deploying!)
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Protect /api/cron/* on Vercel (Vercel sends this header automatically).
CRON_SECRET=change-me

# 2) AI provider — pick ONE active provider, or list many and switch in Settings.
#    Values: openai | gemini | anthropic | openrouter | groq | deepseek | mistral
#            | ollama | lmstudio | custom
AI_PROVIDER=ollama
AI_MODEL=llama3.1
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# --- Cloud API keys (only needed for the provider you pick) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# --- Local / self-hosted (Ollama, LM Studio, llama.cpp, vLLM, ...) ---
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Any OpenAI-compatible endpoint (e.g. http://192.168.1.50:8000/v1)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# 3) Google — OAuth client (Gmail + Sheets). Also settable in Settings UI.
#    Create at https://console.cloud.google.com/apis/credentials
#    Authorized redirect URI: http://localhost:3000/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# Optional: default spreadsheet id used by the finance/customer sync.
GOOGLE_SHEET_ID=

# Optional: service account (headless automation). Paste JSON or path.
GOOGLE_SERVICE_ACCOUNT_JSON=

# 4) Meta — WhatsApp Cloud API + Instagram Messaging
#    Webhook URL: https://your-app.vercel.app/api/webhooks/meta
META_VERIFY_TOKEN=devzard-motion
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# 5) Behaviour
# Auto-send AI replies without human approval (0 = always draft for review).
AUTOSEND_CONFIDENCE_THRESHOLD=0
# Default monthly budget used by the finance dashboard (plain number).
DEFAULT_MONTHLY_BUDGET=1000
