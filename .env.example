# Copy to .env.local. Never commit real secrets.
# Required for Google OAuth and hosted authentication: openssl rand -hex 32
SESSION_SECRET=
# Required on Vercel. Set on ANY other publicly exposed host too.
APP_PASSWORD=
# Public URL, no trailing slash. For local development:
APP_URL=http://localhost:3000

# openai | ollama | compatible
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# For custom endpoints, set AI_PROVIDER=compatible and an endpoint including /v1.
# AI_BASE_URL=https://your-inference-server.example/v1
# Local alternative (run `ollama pull qwen2.5:7b`):
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b
# AI_BASE_URL=http://localhost:11434/v1

# Enable Gmail API + Google Sheets API in Google Cloud.
# OAuth client type: Web application
# Authorized redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub App for repository code proposals (never commit real values).
# App permissions: Metadata read, Contents read/write. Setup URL: {APP_URL}/api/github/callback
# The app installation restricts Relay to repositories selected during installation.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional independent endpoint when switching to Ollama in the UI:
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Neon Postgres persistence (optional). No local PostgreSQL installation needed.
# Copy the FULL pooled URL from Neon > Connect. Keep its actual database name.
# Set only on your laptop/server, never in browser code or Git.
# APP_PASSWORD and your original SESSION_SECRET are required in database mode.
# DATABASE_URL="postgresql://YOUR_ROLE:YOUR_PASSWORD@YOUR_ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# The values above are placeholders, NOT a working account.
# After setting DATABASE_URL: npm run db:migrate, then npm run db:check
# Existing standard PostgreSQL connections still work without a data migration.

# Exact origins permitted in the editable AI endpoint field (comma-separated).
# Local Ollama, OpenAI, Google Gemini, and AI_BASE_URL/OLLAMA_BASE_URL origins are already allowed.
# AI_ALLOWED_ORIGINS=https://your-inference-host.example

# Google Gemini (no AI_ALLOWED_ORIGINS entry needed for the official endpoint):
# AI_PROVIDER=compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=your-gemini-api-key
# Use a model ID available to your key; the model above is an example.
