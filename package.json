{
  "name": "relay-agent",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "desktop:dev": "electron .",
    "desktop:dist:win": "npm run build && electron-builder --win nsis --x64",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "ollama:setup": "node scripts/ollama-tunnel.mjs --setup",
    "ollama:gateway": "node scripts/ollama-tunnel.mjs",
    "db:check": "node scripts/migrate.mjs --check"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "pdf-parse": "1.1.1",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "ai.relay.desktop",
    "productName": "Relay",
    "asar": true,
    "directories": {
      "output": "desktop/dist"
    },
    "files": [
      "desktop/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "relay-server"
      },
      {
        "from": ".next/static",
        "to": "relay-server/.next/static"
      },
      {
        "from": "public",
        "to": "relay-server/public"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Relay-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
